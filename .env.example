# Application (server-only — do NOT prefix with NEXT_PUBLIC_)
APP_URL=                              # e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=                  # public app URL used by auth/reset scripts

# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# Supabase QA test user (server-only; use non-demo values for remote QA)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# PromptPay + slip2go billing (active SaaS payment provider — server-only)
SLIP2GO_API_KEY=                      # slip2go API key (Bearer) for slip verification
SLIP2GO_BASE_URL=                     # optional, default https://connect.slip2go.com

# Stripe SaaS billing (DISABLED while billing_provider=promptpay; code kept)
STRIPE_SECRET_KEY=                    # sk_live_... or sk_test_... in development
STRIPE_WEBHOOK_SECRET=                # whsec_... from Stripe Dashboard → Webhooks
STRIPE_PRICE_STARTER=                 # Stripe Price ID for starter plan
STRIPE_PRICE_STANDARD=                # Stripe Price ID for standard plan
STRIPE_PRICE_PREMIUM=                 # Stripe Price ID for premium plan
STRIPE_PRICE_ENTERPRISE=              # Stripe Price ID for enterprise plan

# LINE Messaging API notifications (server-only)
LINE_CHANNEL_ACCESS_TOKEN=            # Messaging API channel access token
LINE_CHANNEL_SECRET=                  # Messaging API channel secret for x-line-signature verification
LINE_OFFICIAL_ACCOUNT_ID=             # e.g. @103dtwpz
LINE_ADD_FRIEND_URL=                  # e.g. https://line.me/R/ti/p/@103dtwpz
LINE_ACCOUNT_LINK_BASE_URL=           # public app base URL, e.g. https://your-app.vercel.app

# Transactional email — Resend (server-only; used for Enterprise request emails)
RESEND_API_KEY=                       # re_... from resend.com → API Keys
ENTERPRISE_FROM_EMAIL=                # verified sender, e.g. StoreOS <no-reply@yourdomain.com>

# Future integrations
# TELEGRAM_BOT_TOKEN=                 # Telegram bot token (optional notifications channel)

# Vercel (auto-injected by Vercel runtime — do not commit)
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=

# ─── AI (Task 9/D, v0.34.0) — provider: OpenAI ──────────────────────────────
# ใส่ key จริงเฉพาะในเครื่อง (.env) หรือ Vercel env — ห้าม commit key จริง
# การเพิ่ม key บน production env ต้องได้รับอนุมัติแยก (plan gate)
OPENAI_API_KEY=
# โมเดลที่อนุมัติ (ต้องอยู่ใน allowlist ของ src/modules/ai/gateway.ts)
AI_MODEL_ID=gpt-4o-mini
# งบ token รายเดือนต่อองค์กร (quota server-side)
AI_MONTHLY_TOKEN_BUDGET=100000