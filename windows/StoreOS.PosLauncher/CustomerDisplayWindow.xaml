<Window x:Class="StoreOS.PosLauncher.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/storeos.ico"
        Title="StoreOS — จอลูกค้า"
        Width="1280" Height="720"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="Black">
    <!-- จอลูกค้า: มีแต่ WebView2 ไม่มีกรอบ (ถ้ามีจอที่สอง = เต็มจอนั้น) / ปิดโปรแกรมหลักแล้วปิดตาม (Owner) -->
    <wv2:WebView2 x:Name="DisplayWeb" />
</Window>
