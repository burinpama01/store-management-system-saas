<Window x:Class="StoreOS.PosLauncher.PrinterToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เครื่องพิมพ์ — StoreOS POS" Width="720" Height="560"
        WindowStartupLocation="CenterOwner" Background="#F6F4F1" FontSize="14">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" FontSize="17" FontWeight="Bold" Text="ค้นหาเครื่องพิมพ์ในวง WiFi" />
        <TextBlock DockPanel.Dock="Top" Foreground="#6A615A" Margin="0,2,0,8" TextWrapping="Wrap"
                   Text="หาเครื่องที่เปิดพอร์ต 9100 ในวงเดียวกับเครื่องนี้ (ไม่ส่งข้อมูล ไม่ออกกระดาษ) — นำ IP ที่เจอไปตั้งในแท็บ &quot;เครื่องพิมพ์&quot;" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ScanButton" Content="🔍  ค้นหาเครื่องพิมพ์" Padding="14,6" Click="OnScan" />
            <TextBlock x:Name="ScanStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#6A615A" />
        </StackPanel>
        <ListBox DockPanel.Dock="Top" x:Name="FoundList" Height="90" Margin="0,0,0,14" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock FontSize="17" FontWeight="Bold" Text="ประวัติการพิมพ์ (50 งานล่าสุด ตั้งแต่เปิดโปรแกรม)" />
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="รีเฟรช" Padding="10,4" Click="OnRefresh" />
        </DockPanel>
        <ListBox x:Name="HistoryList" FontFamily="Consolas, Tahoma" FontSize="13" />
    </DockPanel>
</Window>
