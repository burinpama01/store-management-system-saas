<Window x:Class="StoreOS.PosLauncher.MusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/storeos.ico"
        Title="StoreOS — เพลงในร้าน"
        Width="1100" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F6F4F1">
    <!-- เครื่องเล่นเพลง + คิวขอเพลง (/player/<slug>) — กดปิด = ซ่อน เพลงเล่นต่อ / ปุ่ม "หยุดเพลง" ในโปรแกรมหลักปิดจริง -->
    <wv2:WebView2 x:Name="PlayerWeb" />
</Window>
