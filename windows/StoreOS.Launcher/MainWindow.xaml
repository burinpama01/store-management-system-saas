<Window x:Class="StoreOS.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/storeos.ico"
        Title="StoreOS" Height="800" Width="1280" WindowState="Maximized">
    <DockPanel>
        <!-- แถบสถานะระบบพิมพ์: POS ต้องเปิดใช้งานได้เสมอ แถบนี้บอกว่าพิมพ์ได้หรือยัง -->
        <Border DockPanel.Dock="Top" Padding="10,6" Background="#F4EFE9">
            <DockPanel LastChildFill="True">
                <!-- แจ้งอัปเดต Launcher (0.5.0+) — ซ่อนไว้จนมีรุ่นใหม่พร้อมติดตั้ง -->
                <StackPanel x:Name="UpdatePanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="UpdateText" FontSize="13" Foreground="#6B3A12" VerticalAlignment="Center" />
                    <Button x:Name="UpdateNowButton" Content="อัปเดตตอนนี้" Margin="10,0,0,0" Padding="10,2"
                            Click="OnUpdateNowClick" />
                    <Button x:Name="UpdateLaterButton" Content="ภายหลัง" Margin="6,0,0,0" Padding="10,2"
                            Click="OnUpdateLaterClick" />
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="13" Foreground="#29231F" Text="กำลังเตรียมระบบพิมพ์..."
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
