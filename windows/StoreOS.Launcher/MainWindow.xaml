<Window x:Class="StoreOS.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="StoreOS" Height="800" Width="1280" WindowState="Maximized">
    <DockPanel>
        <!-- แถบสถานะระบบพิมพ์: POS ต้องเปิดใช้งานได้เสมอ แถบนี้บอกว่าพิมพ์ได้หรือยัง -->
        <Border DockPanel.Dock="Top" Padding="10,6" Background="#F4EFE9">
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="#29231F" Text="กำลังเตรียมระบบพิมพ์..." />
        </Border>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
